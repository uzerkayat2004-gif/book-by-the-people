{
  "name": "book-by-the-people",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 43123 --hostname 127.0.0.1",
    "predev": "tsx scripts/ensure-db.ts",
    "build": "node scripts/prisma-schema.mjs && prisma generate && next build",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "next start -p 43123 --hostname 127.0.0.1",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "prisma db push && tsx prisma/seed.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prisma:schema": "node scripts/prisma-schema.mjs",
    "start:prod": "prisma db push --skip-generate && next start --hostname 0.0.0.0 -p ${PORT:-3000}"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@base-ui/react": "^1.9.0",
    "@breezystack/lamejs": "^1.2.7",
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.8.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "espeak-ng": "^1.0.2",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "nodemailer": "^7.0.13",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
