generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // native for local dev; rhel-openssl-3.0.x for Vercel Functions (Amazon Linux 2023).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email       String    @unique
  name        String?
  image       String?
  countryCode String    @default("")
  region      String    @default("")
  ageBand     String    @default("")
  handle      String    @default("")
  createdAt DateTime  @default(now())
  books     Book[]
  sessions  Session[]
  aiProviders AiProvider[]
  /// When the picked AI model fails, try the next one in the list.
  aiFallback  Boolean   @default(false)
}

/// A creator's AI model (writer and/or transcription). Shared by all of their books.
/// The API key is AES-256-GCM sealed (see src/lib/secret-box.ts); only the last 4 characters are kept readable.
model AiProvider {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String
  type        String
  baseUrl     String
  model       String
  role        String    @default("writer")
  priority    Int       @default(0)
  enabled     Boolean   @default(true)
  keyCipher   String    @default("")
  keyLast4    String    @default("")
  localModel  String    @default("")
  lastTestOk  Boolean?
  lastTestMsg String    @default("")
  lastTestAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, priority])
}

model MagicLink {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Book {
  id                   String           @id @default(cuid())
  slug                 String           @unique
  title                String
  question             String
  type                 String
  coverVibe            String           @default("ember")
  status               String           @default("COLLECTING")
  closesAt             DateTime?
  publishedAt          DateTime?
  creatorId            String
  creator              User             @relation(fields: [creatorId], references: [id])
  inviteToken          String           @unique
  featured             Boolean          @default(false)
  /// Link-only: the book never shows in /books, the Library or on the home page.
  unlisted             Boolean          @default(false)
  pollQuestion         String           @default("What should the next book ask?")
  bookNumber           Int              @default(1)
  aiPaused             Boolean          @default(false)
  /// Optional usage limit for this book: "none", "usd" or "tokens". AI stops when it is reached.
  usageLimitKind       String           @default("none")
  usageLimitValue      Float            @default(0)
  showPoll             Boolean          @default(true)
  voiceLimitPerDay     Int              @default(3)
  maxVoiceSeconds      Int              @default(600)
  language             String           @default("en")
  aiKeyCipher          String           @default("")
  /// The creator's saved AI model this book runs on ("" = their first model). aiModel overrides its model id.
  aiProviderId         String           @default("")
  aiModel              String           @default("")
  audiobookName        String           @default("")
  videoName            String           @default("")
  audiobookKey         String?
  videoKey             String?
  audiobookBytes       Int              @default(0)
  videoBytes           Int              @default(0)
  currentDraftId       String?
  publishedDraftId     String?
  generationError      String?
  generationLog        String?
  generationStartedAt  DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  voices               Voice[]
  drafts               BookDraft[]
  pollOptions          PollOption[]
  pollVotes            PollVote[]
  challenges           VoiceChallenge[]
  jobs                 PipelineJob[]
  backups              Backup[]

  @@index([status, type, unlisted, createdAt])
  @@index([status, unlisted, publishedAt])
  @@index([language])
  @@index([creatorId, createdAt])
  @@index([featured])
}

model Voice {
  id              String   @id @default(cuid())
  bookId          String
  book            Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  contributorName String
  language        String
  countryCode     String?
  handle          String   @default("")
  ageBand         String   @default("")
  region          String   @default("")
  consentAt       DateTime
  storageKey      String?
  mimeType        String?
  durationMs      Int      @default(0)
  startWord       String   @default("")
  startWordPassed Boolean  @default(false)
  originalText    String   @default("")
  englishText     String   @default("")
  translated      Boolean  @default(false)
  turnsJson       String   @default("[]")
  status          String   @default("PROCESSING")
  hidden          Boolean  @default(false)
  rejectReason    String?
  sourceUrl       String?
  sourceTitle     String?
  sourceDate      String   @default("")
  userId          String   @default("")
  decision        String   @default("")
  themeLabel      String   @default("")
  pipelineStep    String   @default("")
  checkJson       String   @default("{}")
  kind            String   @default("voice")
  /// A guest contributor's private key (sha256 of their browser's bbtp_guest cookie), so they can see and delete their own voice.
  guestKey        String   @default("")
  createdAt       DateTime @default(now())

  @@index([bookId, createdAt])
  @@index([bookId, status, hidden])
  @@index([userId])
}

model BookDraft {
  id          String   @id @default(cuid())
  bookId      String
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  version     Int
  contentJson String
  note        String   @default("")
  provider    String   @default("mock")
  model       String   @default("")
  createdAt   DateTime @default(now())

  @@unique([bookId, version])
}

model PollOption {
  id       String     @id @default(cuid())
  bookId   String
  book     Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  label    String
  position Int        @default(0)
  votes    PollVote[]
}

model PollVote {
  id        String     @id @default(cuid())
  bookId    String
  book      Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  voterKey  String
  createdAt DateTime   @default(now())

  @@unique([bookId, voterKey])
}

model VoiceChallenge {
  id         String    @id @default(cuid())
  bookId     String
  book       Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  language   String
  startWord  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}

model PipelineJob {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  voiceId   String?
  step      String
  status    String   @default("pending")
  attempts  Int      @default(0)
  lastError String?
  runAfter  DateTime @default(now())
  key       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookId, status])
}

model Backup {
  id         String   @id @default(cuid())
  bookId     String
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  voiceCount Int      @default(0)
  label      String
  note       String   @default("")
  snapshot   String   @default("")
  createdAt  DateTime @default(now())
}

model AiUsage {
  id           String   @id @default(cuid())
  kind         String
  provider     String
  model        String
  bookId       String?
  voiceId      String?
  inputTokens  Int      @default(0)
  cachedTokens Int      @default(0)
  outputTokens Int      @default(0)
  audioMs      Int      @default(0)
  estimatedUsd Float    @default(0)
  createdAt    DateTime @default(now())
}
