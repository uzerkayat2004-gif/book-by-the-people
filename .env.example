# Copy to .env. The app runs with no keys: AI_MODE=mock uses local transcripts and a local book draft.

DATABASE_URL="file:./data/bbtp.db"
# Production: switch prisma/schema.prisma datasource provider to "postgresql"
# and set DATABASE_URL="postgresql://user:pass@host:5432/bookbythepeople"

APP_URL="http://127.0.0.1:43123"
AI_MODE="mock"

# Meta Model API. Docs: https://dev.meta.ai/docs/overview
# MODEL_API_KEY is accepted as an alias of META_API_KEY.
META_API_KEY=""
MODEL_API_KEY=""
META_API_BASE_URL="https://api.meta.ai/v1"
META_TRANSCRIBE_MODEL="muse-voice-transcribe-1.0"
# ENDPOINTING returns turn timestamps. PUSH_TO_TALK returns one transcript and empty turns.
META_TRANSCRIBE_MODE="ENDPOINTING"

# Writing model. Muse Spark on the Meta Model API (OpenAI-compatible chat completions).
META_WRITER_BASE_URL=""
META_WRITER_API_KEY=""
META_WRITER_MODEL="muse-spark-1.3"
# Muse Spark always reasons. "none" is rejected. low | minimal | medium | high | xhigh
META_WRITER_REASONING_EFFORT="low"

# Fallback when Muse Spark is unreachable (for example from a region where it is not offered).
# Point this at an OpenAI-compatible host: self-hosted Muse Spark Open, Fireworks, Baseten, vLLM.
# The default model id is the Hugging Face repo for Muse Spark Open. Hosted providers use their own id.
WRITER_FALLBACK_BASE_URL=""
WRITER_FALLBACK_API_KEY=""
WRITER_FALLBACK_MODEL="meta-models/Muse-Spark-Open-816B-A42B"

# Usage limits are set per book in Book settings → AI for this book (no limit, dollars, or tokens).
# Optional: one operator cap in dollars for every book on this server. Empty = none.
# (AI_SPEND_CAP_USD from older versions is ignored.)
AI_SERVER_CAP_USD=""
# Prices used to estimate spend. Defaults match Meta's published standard rates (October 2026).
AI_PRICE_TRANSCRIBE_PER_HOUR="0.18"
AI_PRICE_INPUT_PER_MTOK="1.25"
AI_PRICE_CACHED_INPUT_PER_MTOK="0.15"
AI_PRICE_OUTPUT_PER_MTOK="4.25"

# Audio. local writes ./data/audio. s3 works with R2, MinIO, and AWS.
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./data/audio"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# Creators. In development the magic link is shown on the sign-in page.
# Set AUTH_DEV_EXPOSE_LINKS=false in production and configure Resend, or use Google.
AUTH_DEV_EXPOSE_LINKS="true"
RESEND_API_KEY=""
EMAIL_FROM=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Audiobook voice. mock (default) uses espeak-ng and writes a real file.
# http posts { "text" } to TTS_URL and stores the audio response.
TTS_PROVIDER="mock"
TTS_URL=""
TTS_API_KEY=""

# Encrypts stored AI keys at rest (AES-256-GCM): Book settings → AI models and
# per-book keys. Keys are never sent back to the browser (only the last 4 show).
# Leave empty locally: a secret is generated once into data/ai-key-secret.
# Set it in production. Generate with: openssl rand -base64 32
AI_KEY_SECRET=""

# One-click local Meta model (Book settings → AI model → Meta models on this computer).
# Where the model files (0.8–17 GB) and the llama.cpp server go. Default ./data/models.
# On a laptop with a small C: drive, point this at another drive, e.g. D:\BookByThePeople\models
LOCAL_MODELS_DIR=""
# Windows example: LOCAL_MODELS_DIR="E:\\BookByThePeople\\models"
LOCAL_MODEL_PORT="43180"
LOCAL_MODEL_CTX="8192"
LLAMA_CPP_BUILD="b11927"
LLAMA_CPP_ASSET=""
# Optional. Used only when Ollama is installed and running.
OLLAMA_HOST="http://127.0.0.1:11434"

# Optional TTF used for titles in the release video (ffmpeg drawtext).
MEDIA_FONT=""
